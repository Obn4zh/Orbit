<Window x:Class="Orbit.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Orbit.Windows.ViewModels"
        Title="Orbit" Width="1040" Height="700" MinWidth="880" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Icon="Assets/orbit.ico"
        FontFamily="{StaticResource UiFont}" FontSize="14"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">

    <Grid>
        <Grid Margin="24,16,24,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ============================================================ Device panel -->
            <Border Style="{StaticResource Card}" Padding="24">
                <DockPanel LastChildFill="False">
                    <StackPanel DockPanel.Dock="Top">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="Assets/orbit-256.png" Width="22" Height="22" RenderOptions.BitmapScalingMode="HighQuality" />
                            <TextBlock Text="Orbit" Margin="8,0,0,0" VerticalAlignment="Center" Style="{StaticResource BodyStrongText}" />
                        </StackPanel>

                        <!-- Orbit radar -->
                        <Grid x:Name="Radar" Width="190" Height="190" Margin="0,22,0,10" HorizontalAlignment="Center">
                            <Ellipse x:Name="Ring1" Stroke="{StaticResource BrandBrush}" StrokeThickness="1.5" Opacity="0" RenderTransformOrigin="0.5,0.5"><Ellipse.RenderTransform><ScaleTransform /></Ellipse.RenderTransform></Ellipse>
                            <Ellipse x:Name="Ring2" Stroke="{StaticResource BrandBrush}" StrokeThickness="1.5" Opacity="0" RenderTransformOrigin="0.5,0.5"><Ellipse.RenderTransform><ScaleTransform /></Ellipse.RenderTransform></Ellipse>
                            <Ellipse x:Name="Ring3" Stroke="{StaticResource BrandBrush}" StrokeThickness="1.5" Opacity="0" RenderTransformOrigin="0.5,0.5"><Ellipse.RenderTransform><ScaleTransform /></Ellipse.RenderTransform></Ellipse>
                            <Ellipse x:Name="StaticRing" Width="128" Height="128" Stroke="{DynamicResource ControlStrokeColorDefaultBrush}" StrokeThickness="1" />
                            <Grid Width="76" Height="76">
                                <Ellipse x:Name="Core" Fill="{StaticResource BrandGradient}">
                                    <Ellipse.Effect><DropShadowEffect Color="#5B5BF6" BlurRadius="28" ShadowDepth="0" Opacity="0.55" /></Ellipse.Effect>
                                </Ellipse>
                                <Ellipse x:Name="CoreOff" Fill="{DynamicResource ControlAltFillColorSecondaryBrush}" Stroke="{DynamicResource ControlStrokeColorDefaultBrush}" Visibility="Collapsed" />
                                <TextBlock x:Name="CoreGlyph" Text="&#xE7F8;" Style="{StaticResource Icon}" FontSize="28" Foreground="White" />
                            </Grid>
                        </Grid>

                        <TextBlock Text="This PC appears as" HorizontalAlignment="Center" Style="{StaticResource CaptionText}" />

                        <!-- Device name (view / edit) -->
                        <Grid Margin="0,4,0,0" HorizontalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Visibility="{Binding IsEditingName, Converter={StaticResource InverseBoolToVis}}">
                                <TextBlock Text="{Binding DeviceName}" Style="{StaticResource TitleText}" MaxWidth="230" />
                                <Button Command="{Binding EditNameCommand}" Content="&#xE70F;" Style="{StaticResource IconButton}" Margin="6,2,0,0" ToolTip="Rename this device" AutomationProperties.Name="Rename" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Visibility="{Binding IsEditingName, Converter={StaticResource BoolToVis}}">
                                <TextBox x:Name="NameBox" Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}" MaxLength="40" Width="200" KeyDown="NameBox_KeyDown" />
                                <Button Command="{Binding SaveNameCommand}" Content="&#xE73E;" Style="{StaticResource IconButton}" Margin="6,0,0,0" ToolTip="Save" />
                            </StackPanel>
                        </Grid>

                        <!-- Status pill -->
                        <Border HorizontalAlignment="Center" Margin="0,10,0,0" Padding="12,5" CornerRadius="14"
                                Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                                         Fill="{Binding StatusKind, Converter={StaticResource StateToBrush}, ConverterParameter='ok=SuccessBrush;error=DangerBrush;*=WarningBrush'}" />
                                <TextBlock Text="{Binding StatusText}" Margin="8,0,0,0" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Border>
                        <TextBlock Text="{Binding ServerError}" Visibility="{Binding ServerError, Converter={StaticResource NullToVis}}"
                                   Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,0" FontSize="12" />
                    </StackPanel>

                    <!-- Settings -->
                    <StackPanel DockPanel.Dock="Bottom">
                        <Separator Margin="0,0,0,8" Opacity="0.6" />
                        <DockPanel Margin="0,8">
                            <CheckBox DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding ReceivingEnabled}" AutomationProperties.Name="Receiving" />
                            <StackPanel>
                                <TextBlock Text="Receiving" Style="{StaticResource BodyStrongText}" />
                                <TextBlock Text="Visible to iPhones on this network" Style="{StaticResource CaptionText}" />
                            </StackPanel>
                        </DockPanel>
                        <DockPanel Margin="0,8">
                            <CheckBox DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding RequireApproval}" AutomationProperties.Name="Ask before accepting" />
                            <StackPanel>
                                <TextBlock Text="Ask before accepting" Style="{StaticResource BodyStrongText}" />
                                <TextBlock Text="Confirm each incoming transfer" Style="{StaticResource CaptionText}" />
                            </StackPanel>
                        </DockPanel>
                        <DockPanel Margin="0,8,0,0">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="&#xE838;" Command="{Binding OpenFolderCommand}" Style="{StaticResource IconButton}" ToolTip="Open folder" AutomationProperties.Name="Open folder" />
                                <Button Content="Change" Command="{Binding ChangeFolderCommand}" Style="{StaticResource LinkButton}" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Save to" Style="{StaticResource BodyStrongText}" />
                                <TextBlock Text="{Binding DownloadFolder}" ToolTip="{Binding DownloadFolder}" Style="{StaticResource CaptionText}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </DockPanel>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- ============================================================ Right side -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="20" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Send from iPhone -->
                <Border Style="{StaticResource Card}" Padding="20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="176" Height="176" CornerRadius="12" Background="White" Padding="6" VerticalAlignment="Top">
                            <Grid>
                                <Viewbox Stretch="Uniform" Visibility="{Binding QrCode, Converter={StaticResource NullToVis}}">
                                    <Path Data="{Binding QrCode}" Fill="#12131A" />
                                </Viewbox>
                                <TextBlock Text="&#xE701;" Style="{StaticResource Icon}" FontSize="36" Foreground="#8A90A2"
                                           Visibility="{Binding QrCode, Converter={StaticResource NullToVis}, ConverterParameter=invert}" />
                            </Grid>
                        </Border>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <TextBlock Text="Send from your iPhone" Style="{StaticResource SubtitleText}" />
                            <TextBlock Margin="0,10,0,0" Style="{StaticResource BodyText}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" LineHeight="22">
                                <Run Text="1." FontWeight="SemiBold" Foreground="{StaticResource BrandBrush}" /> Point the iPhone Camera at the code<LineBreak />
                                <Run Text="2." FontWeight="SemiBold" Foreground="{StaticResource BrandBrush}" /> Choose photos, videos or files<LineBreak />
                                <Run Text="3." FontWeight="SemiBold" Foreground="{StaticResource BrandBrush}" /> Tap Send — they land in your folder
                            </TextBlock>
                            <Border Margin="0,14,0,0" CornerRadius="8" Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" Padding="10,4,4,4">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Command="{Binding CopyUrlCommand}" Content="{Binding CopyLabel}" Style="{StaticResource LinkButton}" />
                                    <Button DockPanel.Dock="Right" Command="{Binding NextNetworkCommand}" Content="&#xE8AB;" Style="{StaticResource IconButton}" ToolTip="Switch network adapter"
                                            Visibility="{Binding HasMultipleNetworks, Converter={StaticResource BoolToVis}}" />
                                    <TextBlock Text="{Binding NetworkLabel}" VerticalAlignment="Center" FontFamily="Cascadia Mono, Consolas" FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                </DockPanel>
                            </Border>
                            <WrapPanel Margin="-8,8,0,0">
                                <Button Command="{Binding OpenNetworkSettingsCommand}" Style="{StaticResource LinkButton}" Foreground="{StaticResource DangerBrush}"
                                        Visibility="{Binding IsPublicNetwork, Converter={StaticResource BoolToVis}}"
                                        ToolTip="Orbit only receives on networks Windows marks as Private. Open the network's properties and choose Private.">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE7BA;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,6,0" />
                                        <TextBlock Text="Open network settings" />
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding ShowGuideCommand}" Style="{StaticResource LinkButton}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE72D;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,6,0" />
                                        <TextBlock Text="Add to the iPhone Share Sheet" />
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding AllowFirewallCommand}" Style="{StaticResource SubtleButton}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" ToolTip="Adds a Windows Firewall rule for private networks (requires administrator approval)">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE83D;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,6,0" />
                                        <TextBlock Text="iPhone can't connect?" />
                                    </StackPanel>
                                </Button>
                            </WrapPanel>
                            <TextBlock Margin="0,4,0,0" Style="{StaticResource CaptionText}">
                                <Run Text="Pairing code" /> <Run Text="{Binding PairingCode, Mode=OneWay}" FontFamily="Cascadia Mono, Consolas" FontWeight="SemiBold" />
                                <Hyperlink Command="{Binding NewKeyCommand}" Foreground="{StaticResource BrandBrush}" TextDecorations="None" ToolTip="Invalidates the old QR code and Shortcut link">New code</Hyperlink>
                            </TextBlock>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Activity -->
                <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <DockPanel Margin="20,16,14,8">
                            <Button DockPanel.Dock="Right" Content="Clear" Command="{Binding ClearFinishedCommand}" Style="{StaticResource SubtleButton}"
                                    Visibility="{Binding HasFinished, Converter={StaticResource BoolToVis}}" />
                            <TextBlock Text="Activity" Style="{StaticResource SubtitleText}" VerticalAlignment="Center" />
                        </DockPanel>

                        <!-- Empty state -->
                        <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24"
                                    Visibility="{Binding HasSessions, Converter={StaticResource InverseBoolToVis}}">
                            <Grid Width="72" Height="72" HorizontalAlignment="Center">
                                <Ellipse Fill="{StaticResource BrandSoftBrush}" />
                                <TextBlock Text="&#xE896;" Style="{StaticResource Icon}" FontSize="26" Foreground="{StaticResource BrandBrush}" />
                            </Grid>
                            <TextBlock Text="Nothing received yet" Margin="0,14,0,0" HorizontalAlignment="Center" Style="{StaticResource BodyStrongText}" FontSize="15" />
                            <TextBlock Text="Files you send from your iPhone will show up here." Margin="0,4,0,0" HorizontalAlignment="Center" Style="{StaticResource CaptionText}" FontSize="13" />
                        </StackPanel>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="12,0,12,12"
                                      Visibility="{Binding HasSessions, Converter={StaticResource BoolToVis}}">
                            <ItemsControl ItemsSource="{Binding Sessions}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:SessionViewModel}">
                                        <Border Margin="0,4" Padding="14,12" CornerRadius="10" Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="44" />
                                                    <ColumnDefinition Width="14" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Grid Width="44" Height="44" VerticalAlignment="Top">
                                                    <Border CornerRadius="10" Background="{Binding Kind, Converter={StaticResource StateToBrush}, ConverterParameter='Completed=SuccessBrush;Failed=DangerBrush;Canceled=ControlStrokeColorDefaultBrush;*=BrandGradient'}" Opacity="0.16" />
                                                    <TextBlock Text="{Binding Glyph}" Style="{StaticResource Icon}" FontSize="18"
                                                               Foreground="{Binding Kind, Converter={StaticResource StateToBrush}, ConverterParameter='Completed=SuccessBrush;Failed=DangerBrush;Canceled=TextFillColorSecondaryBrush;*=BrandBrush'}" />
                                                </Grid>
                                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Title}" Style="{StaticResource BodyStrongText}" />
                                                    <TextBlock Text="{Binding Subtitle}" Style="{StaticResource CaptionText}" FontSize="13" Margin="0,2,0,0" />
                                                    <ProgressBar Value="{Binding Progress, Mode=OneWay}" Style="{StaticResource OrbitProgress}" Margin="0,8,0,6"
                                                                 Visibility="{Binding ShowProgress, Converter={StaticResource BoolToVis}}" />
                                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource CaptionText}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                                                    <Button Content="Accept" Command="{Binding AcceptCommand}" Style="{StaticResource PrimaryButton}" MinHeight="32" Margin="0,0,6,0"
                                                            Visibility="{Binding Kind, Converter={StaticResource StateToVis}, ConverterParameter=Pending}" />
                                                    <Button Content="Decline" Command="{Binding DeclineCommand}" Style="{StaticResource SubtleButton}"
                                                            Visibility="{Binding Kind, Converter={StaticResource StateToVis}, ConverterParameter=Pending}" />
                                                    <Button Content="&#xE769;" Command="{Binding PauseCommand}" Style="{StaticResource IconButton}" ToolTip="Pause" AutomationProperties.Name="Pause"
                                                            Visibility="{Binding CanPause, Converter={StaticResource BoolToVis}}" />
                                                    <Button Content="&#xE768;" Command="{Binding ResumeCommand}" Style="{StaticResource IconButton}" ToolTip="Resume" AutomationProperties.Name="Resume"
                                                            Visibility="{Binding CanResume, Converter={StaticResource BoolToVis}}" />
                                                    <Button Content="&#xE711;" Command="{Binding CancelCommand}" Style="{StaticResource IconButton}" ToolTip="Cancel" AutomationProperties.Name="Cancel"
                                                            Visibility="{Binding CanCancel, Converter={StaticResource BoolToVis}}" />
                                                    <Button Content="Show" Command="{Binding OpenCommand}" Style="{StaticResource LinkButton}"
                                                            Visibility="{Binding CanOpen, Converter={StaticResource BoolToVis}}" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- ============================================================ Approval overlay -->
        <Grid Visibility="{Binding PendingApproval, Converter={StaticResource NullToVis}}" Background="{StaticResource ScrimBrush}">
            <Border Style="{StaticResource Dialog}" DataContext="{Binding PendingApproval}" Width="440">
                <StackPanel>
                    <Grid Width="56" Height="56" HorizontalAlignment="Left">
                        <Ellipse Fill="{StaticResource BrandGradient}" />
                        <TextBlock Text="&#xE896;" Style="{StaticResource Icon}" FontSize="22" Foreground="White" />
                    </Grid>
                    <TextBlock Text="{Binding ApprovalSummary}" Style="{StaticResource SubtitleText}" TextWrapping="Wrap" Margin="0,16,0,0" />
                    <TextBlock Text="{Binding ApprovalFiles}" Style="{StaticResource BodyText}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,10,0,0" LineHeight="21" />
                    <TextBlock Text="{Binding Countdown}" Style="{StaticResource CaptionText}" Margin="0,12,0,0" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                        <Button Content="Decline" Command="{Binding DeclineCommand}" Style="{StaticResource SubtleButton}" MinWidth="96" MinHeight="36" Margin="0,0,8,0" />
                        <Button x:Name="AcceptButton" Content="Accept" Command="{Binding AcceptCommand}" Style="{StaticResource PrimaryButton}" MinWidth="110" IsDefault="True" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ============================================================ Share Sheet guide -->
        <Grid Visibility="{Binding ShowGuide, Converter={StaticResource BoolToVis}}" Background="{StaticResource ScrimBrush}">
            <Border Style="{StaticResource Dialog}" MaxWidth="580">
                <StackPanel>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="&#xE711;" Command="{Binding CloseGuideCommand}" Style="{StaticResource IconButton}" IsCancel="True" />
                        <TextBlock Text="Add Orbit to the iPhone Share Sheet" Style="{StaticResource SubtitleText}" VerticalAlignment="Center" />
                    </DockPanel>
                    <TextBlock Style="{StaticResource BodyText}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,10,0,0">
                        A one-time setup with Apple's free Shortcuts app. Afterwards "Send to Orbit" appears when you tap Share in Photos or Files, and videos are sent in original quality.
                    </TextBlock>
                    <TextBlock Style="{StaticResource BodyText}" Margin="0,16,0,0" LineHeight="24">
                        <Run Text="1." FontWeight="SemiBold" Foreground="{StaticResource BrandBrush}" /> iPhone → <Run FontWeight="SemiBold" Text="Shortcuts" /> → <Run FontWeight="SemiBold" Text="+" />, name it "Orbit".<LineBreak />
                        <Run Text="2." FontWeight="SemiBold" Foreground="{StaticResource BrandBrush}" /> ⓘ → <Run FontWeight="SemiBold" Text="Show in Share Sheet" /> (Images, Media, Files).<LineBreak />
                        <Run Text="3." FontWeight="SemiBold" Foreground="{StaticResource BrandBrush}" /> Add <Run FontWeight="SemiBold" Text="Scan QR or Barcode" />.<LineBreak />
                        <Run Text="4." FontWeight="SemiBold" Foreground="{StaticResource BrandBrush}" /> Add <Run FontWeight="SemiBold" Text="Repeat with Each" /> item in <Run FontWeight="SemiBold" Text="Shortcut Input" />.<LineBreak />
                        <Run Text="5." FontWeight="SemiBold" Foreground="{StaticResource BrandBrush}" /> Inside it: <Run FontWeight="SemiBold" Text="Get Contents of URL" />, URL = <Run FontWeight="SemiBold" Text="QR/Barcode" />,<LineBreak />
                        <Run Text="    " />Method <Run FontWeight="SemiBold" Text="POST" />, Body <Run FontWeight="SemiBold" Text="Form" />, field <Run FontWeight="SemiBold" Text="file" /> (File) = <Run FontWeight="SemiBold" Text="Repeat Item" />.<LineBreak />
                        <Run Text="6." FontWeight="SemiBold" Foreground="{StaticResource BrandBrush}" /> Share → Orbit → scan this window's QR code → Accept here.
                    </TextBlock>
                    <Border Margin="0,16,0,0" CornerRadius="8" Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" Padding="12,8">
                        <TextBox Text="{Binding ShortcutUrl, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent" FontFamily="Cascadia Mono, Consolas" FontSize="13" TextWrapping="Wrap" />
                    </Border>
                    <TextBlock Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,10,0,0">
                        The scanned QR link accepts uploads directly. To skip scanning, put the fixed link above into step 5 instead (a new pairing code or IP invalidates it).
                    </TextBlock>
                    <Button Content="Done" Command="{Binding CloseGuideCommand}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" MinWidth="96" Margin="0,18,0,0" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- ============================================================ Onboarding -->
        <Grid Visibility="{Binding ShowOnboarding, Converter={StaticResource BoolToVis}}" Background="{StaticResource ScrimBrush}">
            <Border Style="{StaticResource Dialog}" Width="500" Padding="36">
                <StackPanel>
                    <Image Source="Assets/orbit-256.png" Width="64" Height="64" HorizontalAlignment="Left" RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="Welcome to Orbit" Style="{StaticResource TitleText}" Margin="0,18,0,0" />
                    <TextBlock Style="{StaticResource BodyText}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,8,0,0">
                        Get photos, videos and files from your iPhone onto this PC over Wi-Fi. No cables, no cloud, no account.
                    </TextBlock>
                    <StackPanel Margin="0,22,0,0">
                        <DockPanel Margin="0,0,0,14">
                            <TextBlock Text="&#xE701;" Style="{StaticResource Icon}" FontSize="18" Foreground="{StaticResource BrandBrush}" Width="36" VerticalAlignment="Top" />
                            <TextBlock Style="{StaticResource BodyText}"><Run FontWeight="SemiBold" Text="Same Wi-Fi" /><LineBreak /><Run Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="Keep the iPhone and this PC on the same network." /></TextBlock>
                        </DockPanel>
                        <DockPanel Margin="0,0,0,14">
                            <TextBlock Text="&#xE722;" Style="{StaticResource Icon}" FontSize="18" Foreground="{StaticResource BrandBrush}" Width="36" VerticalAlignment="Top" />
                            <TextBlock Style="{StaticResource BodyText}"><Run FontWeight="SemiBold" Text="Scan once" /><LineBreak /><Run Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="Scan the QR code with the Camera. Add the page to the Home Screen or set up the Share Sheet shortcut." /></TextBlock>
                        </DockPanel>
                        <DockPanel>
                            <TextBlock Text="&#xE72E;" Style="{StaticResource Icon}" FontSize="18" Foreground="{StaticResource BrandBrush}" Width="36" VerticalAlignment="Top" />
                            <TextBlock Style="{StaticResource BodyText}"><Run FontWeight="SemiBold" Text="You stay in control" /><LineBreak /><Run Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="Only devices with the pairing code on your local network can send, and you can confirm every transfer." /></TextBlock>
                        </DockPanel>
                    </StackPanel>
                    <TextBlock Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,18,0,0">
                        If Windows asks, allow Orbit on private networks so your iPhone can reach it.
                    </TextBlock>
                    <Button Content="Get started" Command="{Binding FinishOnboardingCommand}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Stretch" MinHeight="40" Margin="0,20,0,0" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
