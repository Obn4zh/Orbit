<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>Orbit.Windows</RootNamespace>
    <AssemblyName>Orbit</AssemblyName>
    <ApplicationIcon>Assets\orbit.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>0.1.0</Version>
    <Product>Orbit</Product>
    <!-- WPF Fluent ThemeMode is marked experimental. -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>

  </PropertyGroup>

  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="QRCoder" Version="1.6.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Orbit.Core\Orbit.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\orbit.ico" />
    <Resource Include="Assets\orbit-256.png" />
  </ItemGroup>

</Project>
